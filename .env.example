# =====================================================================
# qq_chatbot v0.5 configuration template
#
# Usage: copy this file to .env and fill in your own values:
#     Copy-Item .env.example .env
#
# NEVER commit .env (it is gitignored). This template contains no real
# API keys and no real QQ numbers - every value below is a placeholder
# or the code default. Defaults listed here match the source code.
#
# Note: comments are in English on purpose. On a Chinese (GBK) Windows
# console, old pip / dotenv readers may fail to decode UTF-8 Chinese
# comments; English comments avoid that from the root.
# =====================================================================

# ===== NoneBot2 basic config =====
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080

# ===== Group access control (v0.3.1, fail-closed) =====
# Comma-separated QQ group IDs where the bot is allowed to work
# (spaces around commas are allowed).
#   empty / unset  = deny ALL groups (bot fully silent in every group, WARNING at startup)
#   *              = allow all groups (explicitly restores pre-whitelist behavior)
#   invalid IDs    = ERROR + exit at startup
# SECURITY: this is the privacy boundary. Unauthorized groups are not read,
# not logged, not stored, and never trigger any AI call.
ALLOWED_GROUP_IDS=

# ===== AI provider =====
# Primary provider: deepseek | zhipu (restart to apply)
AI_PROVIDER=deepseek
# Fallback provider: deepseek | zhipu | empty = no fallback.
# Same as primary = same-provider dual-model fallback (AI_FALLBACK_MODEL required,
# and it must differ from the primary model).
AI_FALLBACK=
# Optional primary model override (empty = provider default model)
# AI_MODEL=
# Fallback model (required when AI_FALLBACK == AI_PROVIDER; optional otherwise)
# AI_FALLBACK_MODEL=

# ===== DeepSeek API =====
# Fill in your key (starts with sk-). NEVER commit it.
DEEPSEEK_API_KEY=
# Default DeepSeek model used when AI_MODEL is empty (code default: deepseek-flash).
# deepseek-flash = V4.1 Flash, supports BOTH text chat and image input (vision).
# deepseek-chat = V4 Pro compatibility alias, text-only.
# Note: deepseek-v4-flash-vision-exp is a legacy Vision Exp alias - do NOT use it.
DEEPSEEK_MODEL=deepseek-flash

# ===== Zhipu (GLM) API =====
# Fill in your key. NEVER commit it.
ZHIPU_API_KEY=
# Default GLM model used when AI_MODEL is empty (code default: glm-4.7-flash)
ZHIPU_MODEL=glm-4.7-flash

# ===== Bot persona & short-term context =====
# Bot display name used in prompts / group history (code default: 小Q)
BOT_NAME=小Q
# Optional local persona override file, gitignored (default: <project root>/persona.txt)
# PERSONA_FILE=persona.txt
# How many recent messages per group are used as context (1~50, default 20)
CONTEXT_MESSAGE_LIMIT=20
# Optional: override SQLite history DB path (default: <project root>/data/chat_history.db)
# CHAT_HISTORY_DB=data/chat_history.db

# ===== Relationship & long-term memory =====
# The single close-target QQ number (empty = no close user). Non-numeric aborts startup.
CLOSE_USER_ID=
# Max long-term memories of the current user carried in the prompt (1~50, default 10)
USER_MEMORY_LIMIT=10

# ===== Debug commands & Personal Memory (Mini-RAG) =====
# Debug admin QQ whitelist, comma separated (empty = all \debug commands disabled)
DEBUG_ADMIN_QQ=
# Personal memory DB file (default: data/qq_ai_bot.db)
MEMORY_DB_PATH=data/qq_ai_bot.db
# Max retrieved personal memories per question (1~20, default 5)
MEMORY_TOP_K=5
# Max chars of the Personal Memory context block (100~8000, default 1200)
MEMORY_MAX_CHARS=1200

# ===== Runtime state & web search =====
# Timezone for date/time answers (default: Asia/Shanghai; Windows needs the tzdata package)
BOT_TIMEZONE=Asia/Shanghai
# Enable real web search tool calling. Only the program decides this (default: false).
WEB_SEARCH_ENABLED=false
# Search backend: duckduckgo (no key) | bing (HTML parsing)
WEB_SEARCH_BACKEND=duckduckgo
# Per-search timeout in seconds (3~60, default 15)
WEB_SEARCH_TIMEOUT=15
# Max results returned per search (1~10, default 5)
WEB_SEARCH_MAX_RESULTS=5

# ===== Context budget =====
# Max total chars of group history DATA sent to the model (1000~30000, default 6000)
CONTEXT_MAX_CHARS=6000
# Max chars of a single history message (100~3000, default 500)
CONTEXT_SINGLE_MESSAGE_MAX_CHARS=500

# ===== Reply splitting =====
# Split long answers into multiple QQ messages by blank-line paragraphs (default: false)
SPLIT_REPLY_ENABLED=false
# Max parts per reply, rest merged into the last one (1~20, default 6)
SPLIT_REPLY_MAX_PARTS=6
# Max chars per part (100~4000, default 1000)
SPLIT_REPLY_MAX_CHARS=1000
# Delay between parts in ms (0~3000, default 250)
SPLIT_REPLY_DELAY_MS=250

# ===== OneBot access token =====
# SECURITY: must exactly match the token in the NapCat ws client config
# (onebot11_<QQ>.json). Empty = no token check (less safe).
ONEBOT_ACCESS_TOKEN=

# ===== Logging privacy (v0.3.1) =====
# false (default): logs NEVER contain chat text / Personal Memory values /
# long-term memory text / full search queries / Persona lines - only metadata
# (question_chars / retrieved counts / command names ...).
# true: development-only; logs may contain sanitized + truncated message
# content (still goes through secret redaction). Invalid values fall back to false.
LOG_MESSAGE_CONTENT=false

# ===== Scheduled tasks (v0.4, real cron via nonebot-plugin-apscheduler) =====
# Global switch for the scheduler layer (default: false)
SCHEDULED_TASKS_ENABLED=false
# The only scheduled task in v0.4: morning greeting.
# Scheduler decides WHEN; the persona (local persona.txt) decides WHAT to say.
# No canned greeting texts are stored anywhere in the code.
MORNING_GREETING_ENABLED=false
# Cron trigger time, HH:MM in BOT_TIMEZONE (not OS timezone).
# Invalid values abort startup with an error when the scheduler is enabled.
MORNING_GREETING_TIME=08:00
# Comma-separated target QQ group IDs (spaces allowed). Empty = no groups.
# * = all groups in ALLOWED_GROUP_IDS. Groups NOT in ALLOWED_GROUP_IDS are
# always skipped (fail-closed whitelist applies to proactive sends too).
MORNING_GREETING_GROUP_IDS=
# Startup catch-up window in minutes (0 = off, default 30): if the bot starts
# after the scheduled time but within this window, run once (idempotent).
MORNING_GREETING_CATCHUP_MINUTES=30
# Skip the greeting if the bot already spoke in the group within N minutes
# (0 = off, default 10). Only affects whether the event runs, never the persona.
MORNING_GREETING_SKIP_IF_ACTIVE_MINUTES=10

# Night greeting task (same TaskSpec pattern, disabled by default).
# NIGHT_GREETING_ENABLED=false
# NIGHT_GREETING_TIME=21:00
# NIGHT_GREETING_GROUP_IDS=
# NIGHT_GREETING_CATCHUP_MINUTES=30
# NIGHT_GREETING_SKIP_IF_ACTIVE_MINUTES=10

# ===== AMBIENT proactive chat (v0.4, message-event triggered) =====
# Enable natural interjection in whitelisted groups when nobody @'d the bot
# (default: false). Never replies to every message: every human message resets
# the quiet timer, then a cooldown + hourly cap + an LLM should_reply decision
# (which may say "stay silent") gate the actual reply.
AMBIENT_ENABLED=false
# Seconds of group silence before even considering a decision (1~60, default 10)
AMBIENT_QUIET_SECONDS=10
# Do not interject if the bot already spoke within N minutes (1~240, default 30)
AMBIENT_COOLDOWN_MINUTES=30
# Max interjections per group per hour (0~20, default 3; 0 = disable ambient)
AMBIENT_MAX_PER_HOUR=3
# Minimum chars of the RECENT conversation snippet (last few human messages,
# not a single message) to be worth a decision (1~200, default 4).
# Short messages like "哈哈" still reset the quiet timer - they just do not
# qualify as a reply candidate by themselves.
AMBIENT_MIN_MESSAGE_CHARS=4

# ===== Vision (v0.5, DIRECT only; deepseek-flash natively supports images) =====
# Let the bot actually SEE images sent together with an @ message.
# AMBIENT and SCHEDULED do not read images in v0.5.
VISION_ENABLED=true
# Max images handed to the model per request (1~10, default 4); extras ignored.
VISION_MAX_IMAGES=4
# OpenAI image detail level: auto | low | high (default auto)
VISION_DETAIL=auto
# Max bytes per image when NapCat provides file_size (default 10MB = 10485760)
VISION_MAX_IMAGE_BYTES=10485760

# ===== Persona RAG (v0.3.0, NumPy local index, no vector DB) =====
# Enable local persona corpus retrieval (default: true)
PERSONA_RAG_ENABLED=true
# Annotated corpus JSONL (only read by scripts/build_persona_rag.py).
# SECURITY / LEGAL: provide your OWN corpus; it is copyrighted data,
# gitignored, and must never be committed. Replace the path with yours.
PERSONA_RAG_CORPUS=data/persona_processed/yako_processed.jsonl
# Built index directory (embeddings.npy + metadata.jsonl + index_config.json)
PERSONA_RAG_INDEX_DIR=data/persona_rag
# Embedding model (change it = rebuild the index; first use downloads ~100MB;
# set HF_ENDPOINT=https://hf-mirror.com if the download is slow)
PERSONA_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# First-stage recall candidates (5~100, default 24)
PERSONA_RAG_CANDIDATE_K=24
# Final references injected into the prompt (1~8, default 4)
PERSONA_RAG_TOP_K=4
# Minimum final score to inject a reference (0~1, default 0.38 for bge-small-zh-v1.5)
PERSONA_RAG_MIN_SCORE=0.38
# Minimum corpus rag_quality (0~1, default 0.65)
PERSONA_RAG_MIN_QUALITY=0.65
# Maximum spoiler level (0~3, default 0 = no spoilers)
PERSONA_RAG_MAX_SPOILER_LEVEL=0
# Max chars of the query text: question + recent group context (100~4000, default 800)
PERSONA_RAG_MAX_CHARS=800
# Max recent group messages appended to the query (0~3, default 3)
PERSONA_RAG_CONTEXT_MAX_MESSAGES=3
# Topic bonus added during rerank (0~0.05, default 0.05)
PERSONA_RAG_TOPIC_BONUS=0.05
# SECURITY: true logs truncated query / candidates / scores (debug only). Keep false.
PERSONA_RAG_DEBUG=false

# ===== Offline alert email (v0.1, stdlib smtplib) =====
# Enable email alert when the OneBot connection stays down beyond the grace period.
# Detects "OneBot / Bot connection lost" only — it does NOT assert QQ risk-control kicks.
OFFLINE_ALERT_ENABLED=false
# Grace period in seconds before sending the offline email (5~3600, default 60)
OFFLINE_ALERT_GRACE_SECONDS=60
# SMTP server settings (port 465 = SSL; other ports use STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=bot-alert@example.com
# SMTP auth code / password. NEVER commit the real value to Git.
SMTP_PASSWORD=your-smtp-auth-code-here
# Alert destination mailbox
ALERT_EMAIL_TO=admin@example.com
